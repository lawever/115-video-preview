{
  "manifest_version": 3,
  "name": "115 视频预览",
  "version": "0.3.0",
  "description": "在 115 网盘视频页内嵌一个浮窗，按指定数量生成时间均匀分布的预览缩略图",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.115.com/*",
    "*://*.115vod.com/*",
    "*://*.115pan.com/*",
    "*://*.anxia.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "115 视频预览（点击显示/隐藏浮窗）"
  },
  "content_scripts": [{
    "matches": [
      "*://*.115.com/*",
      "*://*.115vod.com/*",
      "*://*.115pan.com/*",
      "*://*.anxia.com/*"
    ],
    "js": ["content/content.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}