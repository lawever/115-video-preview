{
  "manifest_version": 3,
  "name": "115 Thumbnailer",
  "version": "0.3.1",
  "description": "Generate evenly-spaced preview thumbnails for 115 video pages. Click any to jump.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.115.com/*",
    "*://*.115vod.com/*",
    "*://*.115pan.com/*",
    "*://*.anxia.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "115 Thumbnailer (click to show/hide panel)"
  },
  "content_scripts": [{
    "matches": [
      "*://*.115.com/*",
      "*://*.115vod.com/*",
      "*://*.115pan.com/*",
      "*://*.anxia.com/*"
    ],
    "js": ["content/content.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}